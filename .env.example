# =============================================================================
# TechBazzar Database Configuration
# Compatible with local PostgreSQL (pgAdmin) and Cloud DBs (Neon, Supabase, etc.)
# =============================================================================

# Option 1: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=techbazzar_db
PGSSL=false

# Option 2: Full PostgreSQL Connection String
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techbazzar_db

# Backend Server Port
PORT=5000

