{
  "name": "techbazzar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TechBazzar — Next-Gen Electronics & Tech Gadgets E-Commerce with Admin Panel & Image Upload",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "server": "node server/index.js",
    "db:init": "node server/db/init.js",
    "dev:all": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host",
    "start": "vite preview --port 3000 --host"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "lucide-react": "^1.16.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serverless-http": "^4.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
